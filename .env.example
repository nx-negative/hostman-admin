# Neon/Supabase pooled connection — admin's ONLY database (Appendix B)
DATABASE_URL=
# base64 32 bytes — PII field encryption (AES-256-GCM)
FIELD_ENC_KEY=
# Ed25519 root keypair path (auto-generated by setup, gitignored)
ROOT_KEY_PATH=backend/keys/root.ed25519
# bootstrap-only — delete after first mother-admin login
ADMIN_SETUP_CODE=
ADMIN_SETUP_PASSWORD=
BIND=127.0.0.1:8080
RUST_LOG=info
